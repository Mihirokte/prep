{
  "name": "prep-desktop",
  "productName": "Prep",
  "private": true,
  "version": "1.0.0",
  "description": "Interview study and practice, as a local Mac app",
  "type": "module",
  "main": "dist/main/index.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "build": "npm run typecheck && node scripts/copy-pyodide.mjs && vite build && node scripts/build-main.mjs",
    "start": "npm run build && electron .",
    "dev": "node scripts/copy-pyodide.mjs && node scripts/dev.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "install-app": "node scripts/install-app.mjs",
    "verify:seed": "node scripts/run-ts.mjs scripts/verify-seed.ts",
    "verify:app": "npm run build && electron dist/verify/index.cjs",
    "import:seed": "node scripts/run-ts.mjs scripts/import/migrate-from-portfolio.ts",
    "import:verify": "node scripts/run-ts.mjs scripts/import/verify-data-parity.ts"
  },
  "dependencies": {
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.12.4",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@lezer/highlight": "1.2.4",
    "@reduxjs/toolkit": "2.12.0",
    "@tailwindcss/vite": "4.1.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "codemirror": "6.0.2",
    "immer": "11.1.18",
    "lucide-react": "1.47.0",
    "pyodide": "314.0.6",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-redux": "9.3.0",
    "redux-persist": "6.0.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.1.12",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@eslint/js": "9.39.5",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@tailwindcss/oxide@4.1.12": true,
    "fsevents": false
  }
}
